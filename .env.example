# NexusDoc AI Environment Configuration

# Backend API Configuration
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000
WS_URL=ws://localhost:4000

# Database Configuration (PostgreSQL 15 + pgvector)
DATABASE_URL=postgresql://nexus_user:nexus_password@localhost:5432/nexusdoc_db

# Redis Configuration (BullMQ + Pub/Sub)
REDIS_URL=redis://localhost:6379

# AI Provider Configuration
# Set OPENAI_API_KEY to use OpenAI text-embedding-3-large and gpt-4o-mini
# If omitted or left empty, NexusDoc AI runs in resilient offline simulation mode
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-large

# Optional: Gemini API Key if using Google Gemini
GEMINI_API_KEY=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
