{
  "name": "nexusdoc-ai-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "NexusDoc AI - Agentic RAG Knowledge Platform with CRDT-based Real-Time Collaborative Canvas",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace=@nexusdoc/api",
    "build:web": "npm run build --workspace=@nexusdoc/web",
    "start:api": "node apps/api/dist/server.js",
    "start:web": "npm run start --workspace=@nexusdoc/web",
    "lint": "npm run lint --workspaces --if-present"
  },
  "keywords": [
    "crdt",
    "yjs",
    "rag",
    "pgvector",
    "hnsw",
    "bullmq",
    "nextjs",
    "tiptap",
    "realtime-collaboration"
  ],
  "author": "NexusDoc AI Team",
  "license": "MIT"
}
